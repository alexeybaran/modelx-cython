From 80cc016f1816786163e95a3ea20a6d4b1342c53f Mon Sep 17 00:00:00 2001
From: collect proposal <collect-proposal@users.noreply.github.com>
Date: Thu, 26 Nov 2026 00:54:36 +0000
Subject: [PATCH 2/5] DV01 example: lock Data and Actual in the compiled export

Compiled collect runs its items on several threads only when every Space they
read is locked; Data's Cells and Actual's items are read by every Valuation
item. The pooled driver is unchanged.
---
 .../products/fixed_deferred_annuity/dv01_sec/compiled.py    | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/lifelib/libraries/uslib/products/fixed_deferred_annuity/dv01_sec/compiled.py b/lifelib/libraries/uslib/products/fixed_deferred_annuity/dv01_sec/compiled.py
index 39463eab..516c6449 100644
--- a/lifelib/libraries/uslib/products/fixed_deferred_annuity/dv01_sec/compiled.py
+++ b/lifelib/libraries/uslib/products/fixed_deferred_annuity/dv01_sec/compiled.py
@@ -1,8 +1,8 @@
 """Compile the DV01 model with modelx-cython, and load the compiled model.
 
 :func:`build` exports the model built by :func:`model.build_model` on the shipped book into a
-directory, with ``ESG`` and ``Market`` locked (no Cell of theirs is cleared while a report
-runs), copies the input CSVs beside the export, writes the compilation spec
+directory, with ``ESG``, ``Market``, ``Data`` and ``Actual`` locked (no Cell of theirs is cleared
+while a report runs; collect with several workers requires every Space its items read to be locked), copies the input CSVs beside the export, writes the compilation spec
 (:func:`spec`) and the sample run (``sample.py``), and runs the compiler there.  The compiled
 package is ``model_cy`` in that directory.  :func:`load` imports it and points it at a book.
 
@@ -88,7 +88,7 @@ def build(folder, log=None):
     model = build_model()
     try:
         copy_inputs(folder)
-        model.export(folder / PACKAGE, locked_spaces=['ESG', 'Market'])
+        model.export(folder / PACKAGE, locked_spaces=['ESG', 'Market', 'Data', 'Actual'])
         (folder / 'spec.py').write_text(repr(spec(model)) + '\n', encoding='utf-8')
     finally:
         model.close()
